---
const title = "Free Bulk Image Converter – JPG, PNG & WebP | ByteShrink";
const description =
  "Convert up to 50 images to JPG, PNG, or WebP online for free. Adjust quality, resize images, and download converted files individually or as a ZIP. Processing stays in your browser.";
const canonical = Astro.site
  ? new URL("/bulk-image-converter/", Astro.site).href
  : undefined;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ByteShrink Bulk Image Converter",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any",
  description,
  url: canonical,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How do I convert multiple images at once?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Upload multiple images, choose your desired output format, adjust the settings if needed, and select Convert Images. Download files individually or together as a ZIP."
      }
    },
    {
      "@type": "Question",
      name: "Which image formats can I convert?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "ByteShrink accepts common browser-supported image formats, including JPG, PNG, WebP, GIF, and BMP where supported. You can export images as JPG, PNG, or WebP."
      }
    },
    {
      "@type": "Question",
      name: "Are my images uploaded to a server?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Image conversion is performed locally in your browser. Your selected images are not uploaded to a ByteShrink server."
      }
    },
    {
      "@type": "Question",
      name: "Does converting an image reduce its quality?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The result depends on the output format and quality setting. JPG and WebP can use lossy compression, while PNG normally preserves pixel data but may produce larger files."
      }
    },
    {
      "@type": "Question",
      name: "Can I resize images while converting them?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Enable the resize option and enter a maximum width or height. Images are resized proportionally to fit within the specified dimensions."
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8f5" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>

    <meta property="og:site_name" content="ByteShrink" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <style is:global>
      :root {
        color-scheme: light;
        --bg: #f7f8f5;
        --surface: #ffffff;
        --text: #18221d;
        --muted: #727b75;
        --border: #e4e8e2;
        --accent: #237a4b;
        --accent-dark: #195d38;
        --accent-soft: #eaf5ed;
        --danger: #b83b35;
        --shadow: 0 12px 34px rgba(27, 46, 34, 0.055);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 14px;
        line-height: 1.55;
      }

      button,
      input,
      select {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      button:disabled {
        cursor: not-allowed;
        opacity: 0.55;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .topbar {
        min-height: 60px;
        display: flex;
        align-items: center;
        padding: 0 max(18px, calc((100% - 1040px) / 2));
        gap: 20px;
        border-bottom: 1px solid var(--border);
        background: var(--surface);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-size: 19px;
        font-weight: 850;
        letter-spacing: -0.8px;
        white-space: nowrap;
      }

      .brand-mark {
        display: grid;
        width: 29px;
        height: 29px;
        place-items: center;
        border-radius: 9px;
        background: var(--accent);
        color: #fff;
        font-size: 16px;
        font-weight: 900;
      }

      .top-nav {
  display: flex;
  align-items: center;
  gap: 3px;
  margin-left: auto;
  margin-right: 18px;
  padding: 4px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #f3f5f9;
}

.top-nav a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34px;
  padding: 0 13px;
  border: 1px solid transparent;
  border-radius: 7px;
  color: #626d7d;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
  transition: color .15s, background .15s, box-shadow .15s;
}

.top-nav a:hover {
  color: var(--accent);
  background: #fff;
}

.top-nav a[aria-current="page"] {
  border-color: #e5eaf3;
  background: #fff;
  color: var(--accent);
  box-shadow: 0 1px 3px rgba(20, 30, 50, .06);
}

      .privacy-note {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--muted);
        font-size: 10px;
        white-space: nowrap;
      }

      .privacy-dot {
        width: 7px;
        height: 7px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #36a46a;
      }

      .page {
        width: min(100% - 32px, 850px);
        margin: 27px auto 55px;
      }

      .intro {
        margin: 0 auto 20px;
        text-align: center;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border: 1px solid #d8e9dc;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-dark);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.55px;
        text-transform: uppercase;
      }

      h1 {
        margin: 12px 0 8px;
        font-size: clamp(27px, 4.6vw, 38px);
        line-height: 1.13;
        letter-spacing: -1.5px;
      }

      .intro p {
        max-width: 590px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 13px;
      }

      .main-panel,
      .settings-panel,
      .results-panel,
      .content-card {
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .main-panel {
        padding: 17px;
      }

      .dropzone {
        position: relative;
        display: flex;
        min-height: 172px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 22px 15px;
        border: 1.5px dashed #c7d5ca;
        border-radius: 11px;
        background: #fbfcfa;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.18s, background 0.18s;
      }

      .dropzone:hover,
      .dropzone.dragover {
        border-color: var(--accent);
        background: #f1f8f2;
      }

      .drop-icon {
        display: grid;
        width: 43px;
        height: 43px;
        margin-bottom: 10px;
        place-items: center;
        border-radius: 13px;
        background: var(--accent-soft);
        color: var(--accent);
        font-size: 23px;
      }

      .drop-title {
        font-size: 14px;
        font-weight: 800;
      }

      .drop-subtitle {
        margin-top: 4px;
        color: var(--muted);
        font-size: 11px;
      }

      .browse-text {
        color: var(--accent);
        font-weight: 800;
      }

      .file-input {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        clip-path: inset(50%);
      }

      .file-input:focus-visible + .dropzone {
        outline: 3px solid #b3d7bd;
        outline-offset: 3px;
      }

      .file-meta {
        display: none;
        justify-content: space-between;
        gap: 10px;
        margin-top: 12px;
        color: var(--muted);
        font-size: 11px;
      }

      .file-meta.visible {
        display: flex;
      }

      .text-button {
        padding: 0;
        border: 0;
        background: none;
        color: var(--danger);
        font-size: 11px;
        font-weight: 750;
      }

      .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 19px 0 10px;
      }

      .section-heading h2 {
        margin: 0;
        font-size: 13px;
        font-weight: 850;
      }

      .section-heading span {
        color: var(--muted);
        font-size: 10px;
      }

      .format-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 9px;
      }

      .format-option {
        position: relative;
        display: block;
        cursor: pointer;
      }

      .format-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .format-card {
        display: flex;
        min-height: 77px;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 3px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #fff;
        transition: border-color 0.15s, background 0.15s;
      }

      .format-card strong {
        font-size: 14px;
      }

      .format-card small {
        color: var(--muted);
        font-size: 10px;
      }

      .format-option input:checked + .format-card {
        border-color: var(--accent);
        background: var(--accent-soft);
        box-shadow: inset 0 0 0 1px var(--accent);
      }

      .format-option input:focus-visible + .format-card {
        outline: 3px solid #b3d7bd;
        outline-offset: 2px;
      }

      .settings-panel {
        margin-top: 13px;
        padding: 15px 17px;
      }

      .settings-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 13px;
        font-size: 13px;
        font-weight: 850;
      }

      .settings-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px 18px;
      }

      .field {
        min-width: 0;
      }

      .field label,
      .field-label {
        display: block;
        margin-bottom: 6px;
        font-size: 11px;
        font-weight: 800;
      }

      .field select,
      .field input[type="number"] {
        width: 100%;
        min-height: 37px;
        padding: 8px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        outline: none;
        background: #fff;
        color: var(--text);
        font-size: 12px;
      }

      .field select:focus,
      .field input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px #e6f3e9;
      }

      .quality-row {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .quality-row input[type="range"] {
        width: 100%;
        accent-color: var(--accent);
      }

      .quality-value {
        min-width: 39px;
        color: var(--accent);
        font-size: 12px;
        font-weight: 850;
        text-align: right;
      }

      .field-hint {
        margin-top: 5px;
        color: var(--muted);
        font-size: 10px;
      }

      .resize-toggle {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-top: 15px;
        font-size: 11px;
        font-weight: 750;
        cursor: pointer;
      }

      .resize-toggle input {
        margin: 3px 0 0;
        accent-color: var(--accent);
      }

      .resize-fields {
        display: none;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 12px;
      }

      .resize-fields.visible {
        display: grid;
      }

      .resize-fields .field-hint {
        grid-column: 1 / -1;
      }

      .primary-button,
      .secondary-button {
        display: inline-flex;
        min-height: 42px;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 16px;
        border: 1px solid transparent;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 850;
        transition: background 0.15s, border-color 0.15s;
      }

      .primary-button {
        background: var(--accent);
        color: #fff;
      }

      .primary-button:hover:not(:disabled) {
        background: var(--accent-dark);
      }

      .secondary-button {
        border-color: var(--border);
        background: #fff;
        color: var(--text);
      }

      .secondary-button:hover:not(:disabled) {
        border-color: #b7cbbd;
        background: #f8fbf8;
      }

      .convert-button {
        width: 100%;
        margin-top: 16px;
      }

      .status {
        display: none;
        margin-top: 13px;
        padding: 10px 12px;
        border-radius: 8px;
        background: #f1f5f1;
        color: var(--muted);
        font-size: 11px;
      }

      .status.visible {
        display: block;
      }

      .status.error {
        background: #fff0ef;
        color: var(--danger);
      }

      .progress-track {
        display: none;
        height: 5px;
        margin-top: 10px;
        overflow: hidden;
        border-radius: 99px;
        background: #e8ece8;
      }

      .progress-track.visible {
        display: block;
      }

      .progress-bar {
        width: 0;
        height: 100%;
        border-radius: inherit;
        background: var(--accent);
        transition: width 0.2s;
      }

      .results-panel {
        display: none;
        margin-top: 14px;
        padding: 16px;
      }

      .results-panel.visible {
        display: block;
      }

      .results-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
      }

      .results-header h2 {
        margin: 0;
        font-size: 15px;
      }

      .results-header p {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: 11px;
      }

      .results-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
        margin: 14px 0;
      }

      .results-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr));
        align-items: stretch;
        gap: 12px;
      }

      .result-row {
        min-width: 0;
        min-height: 235px;
        display: flex;
        flex-direction: column;
        gap: 9px;
        padding: 9px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(27, 46, 34, 0.035);
        transition: border-color 0.16s, box-shadow 0.16s, transform 0.16s;
      }

      .result-row:hover {
        border-color: #cbd9ce;
        box-shadow: 0 7px 18px rgba(27, 46, 34, 0.08);
        transform: translateY(-1px);
      }

      .result-thumb {
        width: 100%;
        height: 112px;
        display: block;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 7px;
        background: #f4f6f3;
        object-fit: contain;
      }

      .result-info {
        min-width: 0;
        flex: 1;
      }

      .result-name {
        position: relative;
        overflow: hidden;
        color: var(--text);
        font-size: 10px;
        font-weight: 800;
        line-height: 1.45;
        text-overflow: ellipsis;
        white-space: nowrap;
        cursor: default;
      }

      .result-name.has-tooltip:hover::after,
      .result-name.has-tooltip:focus-visible::after {
        content: attr(data-full-name);
        position: absolute;
        z-index: 5;
        top: calc(100% + 6px);
        left: 0;
        width: max-content;
        max-width: min(340px, calc(100vw - 40px));
        padding: 7px 9px;
        border: 1px solid #dfe5ee;
        border-radius: 7px;
        background: #fff;
        color: var(--text);
        font-size: 11px;
        font-weight: 500;
        line-height: 1.4;
        white-space: normal;
        overflow-wrap: anywhere;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .14);
        pointer-events: none;
      }

      .result-detail {
        margin-top: 2px;
        color: var(--muted);
        font-size: 9px;
        line-height: 1.45;
      }

      .result-download {
        width: 100%;
        min-height: 34px;
        margin-top: auto;
        padding: 0 10px;
        border: 1px solid var(--accent);
        border-radius: 7px;
        background: var(--accent);
        color: #fff;
        font-size: 11px;
        font-weight: 850;
        box-shadow: 0 2px 5px rgba(35, 122, 75, .16);
        transition: background .15s, border-color .15s, box-shadow .15s, transform .15s;
      }

      .result-download:hover:not(:disabled) {
        border-color: var(--accent-dark);
        background: var(--accent-dark);
        box-shadow: 0 4px 10px rgba(35, 122, 75, .2);
        transform: translateY(-1px);
      }

      .content-section {
        margin-top: 23px;
      }

      .content-section > h2 {
        margin: 0 0 10px;
        font-size: 18px;
        letter-spacing: -0.4px;
      }

      .content-card {
        padding: 17px;
        box-shadow: none;
      }

      .content-card p {
        margin: 0 0 11px;
        color: #566159;
        font-size: 12px;
      }

      .content-card p:last-child {
        margin-bottom: 0;
      }

      .benefit-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-top: 12px;
      }

      .benefit {
        padding: 13px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #fff;
      }

      .benefit-icon {
        margin-bottom: 5px;
        color: var(--accent);
        font-size: 18px;
      }

      .benefit strong {
        display: block;
        margin-bottom: 4px;
        font-size: 11px;
      }

      .benefit p {
        margin: 0;
        color: var(--muted);
        font-size: 10px;
      }

      .faq-list {
        display: grid;
        gap: 8px;
      }

      .faq-list details {
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #fff;
      }

      .faq-list summary {
        cursor: pointer;
        font-size: 12px;
        font-weight: 800;
      }

      .faq-list details p {
        margin: 9px 0 0;
        color: var(--muted);
        font-size: 11px;
      }

      .related-tools {
        margin-top: 18px;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #fff;
      }

      .related-tools h2 {
        margin: 0 0 5px;
        font-size: 13px;
      }

      .related-tools p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
      }

      .related-tools a {
        color: var(--accent);
        font-weight: 800;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 25px;
        padding-top: 15px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 10px;
      }

      footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      footer a:hover {
        color: var(--accent);
      }

      @media (max-width: 600px) {
        .top-nav {
  order: 3;
  width: 100%;
  margin: 0;
  padding: 4px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: #f3f5f9;
  flex-wrap: nowrap;
  gap: 4px;
}

.top-nav a {
  flex: 1;
  min-width: 0;
  min-height: 36px;
  padding: 0 7px;
  font-size: 11px;
}

        .privacy-note {
          margin-left: auto;
          font-size: 9px;
        }

        .page {
          width: calc(100% - 20px);
          margin-top: 19px;
        }

        h1 {
          font-size: 28px;
        }

        .main-panel,
        .settings-panel,
        .results-panel {
          padding: 12px;
        }

        .dropzone {
          min-height: 145px;
          padding: 16px 9px;
        }

        .settings-grid {
          gap: 12px;
        }

        .results-header {
          flex-direction: column;
        }

        .benefit-grid {
          grid-template-columns: 1fr;
        }

        .result-thumb {
          height: 105px;
        }

        footer {
          align-items: flex-start;
          flex-direction: column;
          gap: 7px;
        }
      }

      @media (max-width: 380px) {
        .format-grid {
          gap: 6px;
        }

        .format-card {
          min-height: 69px;
        }

        .settings-grid {
          grid-template-columns: 1fr;
        }

        .results-actions {
          grid-template-columns: 1fr;
        }

        .privacy-note {
          max-width: 125px;
          white-space: normal;
        }
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="ByteShrink home">
        <span class="brand-mark">B</span>
        <span>ByteShrink</span>
      </a>

      <nav class="top-nav" aria-label="Main navigation">
        <a href="/">Image Compressor</a>
        <a href="/bulk-image-converter/" aria-current="page">Bulk Converter</a>
      </nav>

      <div class="privacy-note">
        <span class="privacy-dot"></span>
        Images stay on your device
      </div>
    </header>

    <main class="page">
