    <script is:inline>
      const $ = (selector) => document.querySelector(selector);

      const fileInput = $("#fileInput");
      const dropzone = $("#dropzone");
      const fileMeta = $("#fileMeta");
      const fileMetaText = $("#fileMetaText");
      const clearFilesButton = $("#clearFilesButton");
      const qualityRange = $("#qualityRange");
      const qualityValue = $("#qualityValue");
      const filenameMode = $("#filenameMode");
      const resizeEnabled = $("#resizeEnabled");
      const resizeFields = $("#resizeFields");
      const maxWidthInput = $("#maxWidth");
      const maxHeightInput = $("#maxHeight");
      const convertButton = $("#convertButton");
      const status = $("#status");
      const progressTrack = $("#progressTrack");
      const progressBar = $("#progressBar");
      const resultsPanel = $("#resultsPanel");
      const resultsSummary = $("#resultsSummary");
      const resultsList = $("#resultsList");
      const downloadZipButton = $("#downloadZipButton");
      const convertMoreButton = $("#convertMoreButton");

      const MAX_FILES = 50;
      const MAX_FILE_SIZE = 50 * 1024 * 1024;
      const ALLOWED_TYPES = new Set([
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/gif",
        "image/bmp",
        "image/avif",
        "image/tiff"
      ]);

      let selectedFiles = [];
      let convertedResults = [];
      let isBusy = false;
      let zipLibraryPromise = null;

      function getOutputFormat() {
        return $('input[name="outputFormat"]:checked')?.value || "image/webp";
      }

      function extensionForMime(mime) {
        if (mime === "image/jpeg") return "jpg";
        if (mime === "image/png") return "png";
        return "webp";
      }

      function formatBytes(bytes) {
        if (!Number.isFinite(bytes) || bytes < 0) return "—";
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
        return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
      }

      function safeBaseName(filename) {
        const lastDot = filename.lastIndexOf(".");
        const base = lastDot > 0 ? filename.slice(0, lastDot) : filename;
        return base.trim() || "image";
      }

      function makeUniqueFilename(filename, mime, usedNames) {
        const extension = extensionForMime(mime);
        const originalBase = safeBaseName(filename);
        const mode = filenameMode.value;
        const base = mode === "converted"
          ? `${originalBase}-converted`
          : originalBase;

        let candidate = `${base}.${extension}`;
        let counter = 2;

        while (usedNames.has(candidate.toLowerCase())) {
          candidate = `${base}-${counter}.${extension}`;
          counter += 1;
        }

        usedNames.add(candidate.toLowerCase());
        return candidate;
      }

      function showStatus(message, kind = "normal") {
        status.textContent = message;
        status.classList.add("visible");
        status.classList.toggle("error", kind === "error");
      }

      function hideStatus() {
        status.textContent = "";
        status.classList.remove("visible", "error");
      }

      function setBusy(busy) {
        isBusy = busy;
        convertButton.disabled = busy;
        fileInput.disabled = busy;
        clearFilesButton.disabled = busy;
        downloadZipButton.disabled = busy || convertedResults.length === 0;
        convertMoreButton.disabled = busy;

        convertButton.innerHTML = busy
          ? 'Converting images <span aria-hidden="true">…</span>'
          : 'Convert Images <span aria-hidden="true">→</span>';
      }

      function setProgress(current, total) {
        progressTrack.classList.add("visible");
        const percentage = total > 0 ? (current / total) * 100 : 0;
        progressBar.style.width = `${Math.max(0, Math.min(100, percentage))}%`;
      }

      function resetProgress() {
        progressTrack.classList.remove("visible");
        progressBar.style.width = "0%";
      }

      function clearResults() {
        convertedResults.forEach((result) => {
          if (result.previewUrl) URL.revokeObjectURL(result.previewUrl);
        });

        convertedResults = [];
        resultsList.replaceChildren();
        resultsPanel.classList.remove("visible");
        resultsSummary.textContent = "";
        downloadZipButton.disabled = true;
      }

      function clearSelection() {
        selectedFiles = [];
        fileInput.value = "";
        fileMeta.classList.remove("visible");
        fileMetaText.textContent = "No images selected";
        clearResults();
        hideStatus();
        resetProgress();
      }

      function validateFiles(incomingFiles) {
        const validFiles = [];
        const rejected = [];

        for (const file of incomingFiles) {
          if (!file || !file.type.startsWith("image/")) {
            rejected.push(`${file?.name || "A file"} is not a supported image.`);
            continue;
          }

          if (file.size > MAX_FILE_SIZE) {
            rejected.push(`${file.name} exceeds the 50 MB file limit.`);
            continue;
          }

          if (!ALLOWED_TYPES.has(file.type.toLowerCase())) {
            rejected.push(`${file.name} has a format this browser may not support.`);
            continue;
          }

          validFiles.push(file);
        }

        return { validFiles, rejected };
      }

      function addFiles(incomingFiles) {
        if (isBusy) return;

        const incoming = Array.from(incomingFiles || []);
        if (!incoming.length) return;

        const remaining = MAX_FILES - selectedFiles.length;
        if (remaining <= 0) {
          showStatus(`You can select up to ${MAX_FILES} images at a time.`, "error");
          return;
        }

        const { validFiles, rejected } = validateFiles(incoming);
        const accepted = validFiles.slice(0, remaining);
        const skippedByLimit = validFiles.length - accepted.length;

        if (accepted.length) {
          selectedFiles = selectedFiles.concat(accepted);
          clearResults();
          hideStatus();
        }

        fileInput.value = "";
        updateFileMeta();

        const messages = [...rejected];
        if (skippedByLimit > 0) {
          messages.push(`${skippedByLimit} image(s) skipped because the 50-image limit was reached.`);
        }

        if (messages.length) {
          showStatus(messages.slice(0, 3).join(" "), "error");
        } else if (accepted.length) {
          showStatus(`${accepted.length} image(s) added. Ready to convert.`);
        }
      }

      function updateFileMeta() {
        if (!selectedFiles.length) {
          fileMeta.classList.remove("visible");
          fileMetaText.textContent = "No images selected";
          return;
        }

        const totalBytes = selectedFiles.reduce((sum, file) => sum + file.size, 0);
        fileMetaText.textContent =
          `${selectedFiles.length} image${selectedFiles.length === 1 ? "" : "s"} selected · ${formatBytes(totalBytes)}`;

        fileMeta.classList.add("visible");
      }

      function loadImage(file) {
        return new Promise((resolve, reject) => {
          const url = URL.createObjectURL(file);
          const image = new Image();

          image.onload = () => {
            URL.revokeObjectURL(url);
            resolve(image);
          };

          image.onerror = () => {
            URL.revokeObjectURL(url);
            reject(new Error(`Could not read ${file.name}.`));
          };

          image.src = url;
        });
      }

      function getTargetDimensions(width, height) {
        if (!resizeEnabled.checked) {
          return { width, height };
        }

        const rawWidth = maxWidthInput.value.trim();
        const rawHeight = maxHeightInput.value.trim();

        const maxWidth = rawWidth ? Number(rawWidth) : Infinity;
        const maxHeight = rawHeight ? Number(rawHeight) : Infinity;

        if (
          (rawWidth && (!Number.isFinite(maxWidth) || maxWidth <= 0)) ||
          (rawHeight && (!Number.isFinite(maxHeight) || maxHeight <= 0))
        ) {
          throw new Error("Enter a valid positive maximum width or height.");
        }

        if (maxWidth === Infinity && maxHeight === Infinity) {
          throw new Error("Enter a maximum width, maximum height, or both.");
        }

        const scale = Math.min(
          1,
          maxWidth / width,
          maxHeight / height
        );

        return {
          width: Math.max(1, Math.round(width * scale)),
          height: Math.max(1, Math.round(height * scale))
        };
      }

      function canvasToBlob(canvas, mime, quality) {
        return new Promise((resolve, reject) => {
          canvas.toBlob(
            (blob) => {
              if (blob) {
                resolve(blob);
              } else {
                reject(new Error(`This browser could not export ${mime}.`));
              }
            },
            mime,
            quality
          );
        });
      }

      async function convertOne(file, usedNames) {
        const image = await loadImage(file);

        if (!image.naturalWidth || !image.naturalHeight) {
          throw new Error(`The image ${file.name} has invalid dimensions.`);
        }

        const dimensions = getTargetDimensions(
          image.naturalWidth,
          image.naturalHeight
        );

        const canvas = document.createElement("canvas");
        canvas.width = dimensions.width;
        canvas.height = dimensions.height;

        const context = canvas.getContext("2d", { alpha: true });
        if (!context) {
          throw new Error("Your browser could not initialize image conversion.");
        }

        context.imageSmoothingEnabled = true;
        context.imageSmoothingQuality = "high";

        const outputMime = getOutputFormat();

        if (outputMime === "image/jpeg") {
          context.fillStyle = "#ffffff";
          context.fillRect(0, 0, canvas.width, canvas.height);
        }

        context.drawImage(image, 0, 0, canvas.width, canvas.height);

        const quality = Number(qualityRange.value) / 100;
        const blob = await canvasToBlob(
          canvas,
          outputMime,
          outputMime === "image/png" ? undefined : quality
        );

        const actualMime = blob.type || outputMime;
        const filename = makeUniqueFilename(file.name, actualMime, usedNames);
        const previewUrl = URL.createObjectURL(blob);

        return {
          originalName: file.name,
          filename,
          blob,
          previewUrl,
          originalSize: file.size,
          outputSize: blob.size,
          width: canvas.width,
          height: canvas.height,
          mime: actualMime
        };
      }

      function makeElement(tag, className, text) {
        const element = document.createElement(tag);
        if (className) element.className = className;
        if (text !== undefined) element.textContent = text;
        return element;
      }

      function renderResults() {
        resultsList.replaceChildren();

        let totalOriginal = 0;
        let totalOutput = 0;

        for (const result of convertedResults) {
          totalOriginal += result.originalSize;
          totalOutput += result.outputSize;

          const row = makeElement("div", "result-row");
          const image = makeElement("img", "result-thumb");
          image.src = result.previewUrl;
          image.alt = "";
          image.loading = "lazy";

          const info = makeElement("div", "result-info");
          const name = makeElement("div", "result-name", result.filename);
          if (result.filename.length > 24) {
            name.classList.add("has-tooltip");
            name.dataset.fullName = result.filename;
            name.tabIndex = 0;
          }

          const detail = makeElement(
            "div",
            "result-detail",
            `${formatBytes(result.originalSize)} → ${formatBytes(result.outputSize)} · ${result.width} × ${result.height}`
          );

          const download = makeElement("button", "result-download", "Download");
          download.type = "button";
          download.addEventListener("click", () => {
            downloadBlob(result.blob, result.filename);
          });

          info.append(name, detail);
          row.append(image, info, download);
          resultsList.append(row);
        }

        const difference = totalOriginal - totalOutput;
        const percentage = totalOriginal > 0
          ? Math.round((difference / totalOriginal) * 100)
          : 0;

        let summary =
          `${convertedResults.length} image${convertedResults.length === 1 ? "" : "s"} converted · ` +
          `${formatBytes(totalOriginal)} total input · ${formatBytes(totalOutput)} total output`;

        if (difference > 0) {
          summary += ` · ${percentage}% smaller`;
        } else if (difference < 0) {
          summary += ` · output is ${Math.abs(percentage)}% larger`;
        } else {
          summary += " · same total size";
        }

        resultsSummary.textContent = summary;
        resultsPanel.classList.add("visible");
        downloadZipButton.disabled = convertedResults.length === 0;
      }

      function downloadBlob(blob, filename) {
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement("a");

        anchor.href = url;
        anchor.download = filename;
        anchor.style.display = "none";

        document.body.append(anchor);
        anchor.click();
        anchor.remove();

        window.setTimeout(() => URL.revokeObjectURL(url), 1500);
      }

      async function loadZipLibrary() {
        if (window.JSZip) return window.JSZip;

        if (!zipLibraryPromise) {
          zipLibraryPromise = new Promise((resolve, reject) => {
            const script = document.createElement("script");
            script.src = "https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js";
            script.async = true;
            script.onload = () => {
              if (window.JSZip) {
                resolve(window.JSZip);
              } else {
                reject(new Error("The ZIP library could not be loaded."));
              }
            };
            script.onerror = () => reject(
              new Error("Could not load the ZIP library. Check your internet connection or download files individually.")
            );
            document.head.append(script);
          });
        }

        return zipLibraryPromise;
      }

      async function downloadAllAsZip() {
        if (!convertedResults.length || isBusy) return;

        downloadZipButton.disabled = true;
        const originalText = downloadZipButton.textContent;
        downloadZipButton.textContent = "Preparing ZIP…";

        try {
          const JSZipLibrary = await loadZipLibrary();
          const zip = new JSZipLibrary();

          for (const result of convertedResults) {
            zip.file(result.filename, result.blob);
          }

          const archive = await zip.generateAsync({
            type: "blob",
            compression: "DEFLATE",
            compressionOptions: { level: 5 }
          });

          downloadBlob(archive, "byteshrink-converted-images.zip");
          showStatus("Your ZIP archive is ready to download.");
        } catch (error) {
          showStatus(
            error instanceof Error ? error.message : "Could not create the ZIP archive.",
            "error"
          );
        } finally {
          downloadZipButton.textContent = originalText;
          downloadZipButton.disabled = convertedResults.length === 0 || isBusy;
        }
      }

      async function runConversion() {
        if (isBusy) return;

        if (!selectedFiles.length) {
          showStatus("Choose at least one image before converting.", "error");
          return;
        }

        if (resizeEnabled.checked) {
          const width = maxWidthInput.value.trim();
          const height = maxHeightInput.value.trim();

          if (!width && !height) {
            showStatus("Enter a maximum width or height to resize images.", "error");
            return;
          }

          for (const [value, label] of [
            [width, "width"],
            [height, "height"]
          ]) {
            if (value && (!Number.isFinite(Number(value)) || Number(value) <= 0 || Number(value) > 12000)) {
              showStatus(`Enter a valid ${label} between 1 and 12000 pixels.`, "error");
              return;
            }
          }
        }

        clearResults();
        hideStatus();
        resetProgress();
        setBusy(true);

        const filesToConvert = [...selectedFiles];
        const usedNames = new Set();
        const failures = [];
        let completed = 0;

        showStatus(`Starting conversion of ${filesToConvert.length} image(s)…`);
        setProgress(0, filesToConvert.length);

        try {
          for (const file of filesToConvert) {
            try {
              const result = await convertOne(file, usedNames);
              convertedResults.push(result);
            } catch (error) {
              failures.push(
                `${file.name}: ${error instanceof Error ? error.message : "Conversion failed."}`
              );
            }

            completed += 1;
            setProgress(completed, filesToConvert.length);

            showStatus(
              `Processed ${completed} of ${filesToConvert.length} image(s)…`
            );

            renderResults();

            // Yield to the browser so the progress display remains responsive.
            await new Promise((resolve) => window.setTimeout(resolve, 0));
          }

          renderResults();

          if (convertedResults.length) {
            const successMessage =
              `${convertedResults.length} image(s) converted successfully.` +
              (failures.length ? ` ${failures.length} image(s) could not be converted.` : "");

            showStatus(successMessage, failures.length ? "error" : "normal");
            resultsPanel.scrollIntoView({ behavior: "smooth", block: "start" });
          } else {
            showStatus(
              failures.length
                ? `No images were converted. ${failures.slice(0, 2).join(" ")}`
                : "No images were converted. Try different files.",
              "error"
            );
          }

          if (failures.length) {
            console.warn("ByteShrink conversion errors:", failures);
          }
        } catch (error) {
          showStatus(
            error instanceof Error ? error.message : "Something went wrong during conversion.",
            "error"
          );
        } finally {
          setBusy(false);
          setProgress(filesToConvert.length, filesToConvert.length);
        }
      }

      qualityRange.addEventListener("input", () => {
        qualityValue.textContent = `${qualityRange.value}%`;
      });

      resizeEnabled.addEventListener("change", () => {
        resizeFields.classList.toggle("visible", resizeEnabled.checked);
      });

      fileInput.addEventListener("change", () => {
        addFiles(fileInput.files);
      });

      clearFilesButton.addEventListener("click", clearSelection);

      convertMoreButton.addEventListener("click", () => {
        if (isBusy) return;
        fileInput.click();
      });

      convertButton.addEventListener("click", runConversion);
      downloadZipButton.addEventListener("click", downloadAllAsZip);

      dropzone.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          fileInput.click();
        }
      });

      ["dragenter", "dragover"].forEach((eventName) => {
        dropzone.addEventListener(eventName, (event) => {
          event.preventDefault();
          if (!isBusy) dropzone.classList.add("dragover");
        });
      });

      ["dragleave", "drop"].forEach((eventName) => {
        dropzone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropzone.classList.remove("dragover");
        });
      });

      dropzone.addEventListener("drop", (event) => {
        if (isBusy) return;
        addFiles(event.dataTransfer?.files);
      });

      window.addEventListener("beforeunload", () => {
        convertedResults.forEach((result) => {
          if (result.previewUrl) URL.revokeObjectURL(result.previewUrl);
        });
      });

      downloadZipButton.disabled = true;
    </script>
  </body>
</html>